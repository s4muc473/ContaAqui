# Copie para .env (local) e configure as mesmas variáveis na Vercel.
# O .env está no .gitignore: nenhuma credencial entra no repositório.

# String completa do MongoDB Atlas, com usuário, senha e host do cluster:
# mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Nome do banco (opcional, padrão: mycoin)
MONGODB_DB=mycoin

# Segredo para assinar o cookie de sessão. Gere um novo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
